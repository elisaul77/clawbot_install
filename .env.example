# Domain for Nginx (OPCIONAL - puedes usar tu IP directamente)
# Si tienes dominio: DOMAIN_NAME=ai.midominio.com
# Si NO tienes dominio: DOMAIN_NAME=203.0.113.10 (usa tu IP pública)
DOMAIN_NAME=yourdomain.com

# VPN Configuration (WireGuard)
# Esta es la IP pública de tu servidor (la que te dio tu hosting)
VPN_PUBLIC_IP=x.x.x.x

# Contraseña para la VPN - el script generará el hash automáticamente
VPN_PASSWORD_HASH=

# Clawbot Security
# El script generará este token automáticamente
CLAWDBOT_TOKEN=
